{
  "name": "nocturne-player",
  "productName": "Nocturne",
  "version": "1.0.0",
  "description": "Nocturne: a music player with a 3D visualiser and synced lyrics (portfolio demo).",
  "author": "Portfolio demo",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "dist:all": "electron-builder --mac --win --linux --x64 --arm64"
  },
  "build": {
    "appId": "com.portfolio.nocturne",
    "productName": "Nocturne",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Portfolio demo"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "three": "^0.160.0"
  }
}
